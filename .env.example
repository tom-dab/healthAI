# ════════════════════════════════════════════════
# HEALTHAI COACH — Variables d'environnement
# ════════════════════════════════════════════════
# 1. Copier ce fichier : cp .env.example .env
# 2. Remplir les valeurs ci-dessous
# 3. Ne JAMAIS commiter le fichier .env
# ════════════════════════════════════════════════

# ─── Base de données PostgreSQL ──────────────────
POSTGRES_DB=healthai_db
POSTGRES_USER=healthai_user
POSTGRES_PASSWORD=CHANGEZ_MOI_mot_de_passe_fort

# ─── API REST ────────────────────────────────────
API_SECRET_KEY=CHANGEZ_MOI_cle_secrete_tres_longue_et_aleatoire
API_DEBUG=true
API_PORT=8000

# ─── Metabase ────────────────────────────────────
METABASE_DB=metabase_db

# ─── ETL ─────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Frontend ────────────────────────────────────
# (déjà géré dans docker-compose.yml via API_PORT)
